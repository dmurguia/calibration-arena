# Local preview works with these blank. Never commit backend/.env.
# Launch: python -m uvicorn app.main:app --app-dir backend --env-file backend/.env --port 8021
PILOT_DATASET=preview
# Use a new, empty database and PILOT_DATASET=cohort-2026-09 for real invitees.
ARENA_LEGACY_API=0
ARENA_AUTO_SEED=0
ARENA_DEV_LOGIN_CODE=0

# Before inviting a cohort: choose a private shared invitation code.
PILOT_INVITE_CODE=
# At least 24 random characters. Server only. Opens /founder; never put in a URL.
PILOT_ADMIN_TOKEN=

# Live Ask requires all three values AND a configured invitation code.
# Model IDs must differ. Account/provider spending limits should also be set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_A=
OPENROUTER_MODEL_B=

# Production: use a durable database/volume. Default is backend/arena.db (SQLite).
# ARENA_DATABASE_URL=sqlite:////absolute/path/on/persistent-volume/pilot.db
# For a separately hosted frontend, use an exact HTTPS origin (no wildcard).
# ARENA_CORS_ORIGINS=https://your-pilot.example

# FUTURE cross-device authentication seam — NOT implemented or read by this pilot.
# Clerk is optional for this cohort, not a current dependency.
# CLERK_SECRET_KEY=
# CLERK_JWKS_URL=
# Frontend, only when integration is implemented: VITE_CLERK_PUBLISHABLE_KEY=

# Temporary local CLI comparison (uses existing CLI sign-ins; no API key).
# Launch only on 127.0.0.1 with one worker; remote/proxied origins are rejected.
# Set ARENA_INFERENCE_BACKEND=local-cli to enable; openrouter is the default.
ARENA_INFERENCE_BACKEND=openrouter
LOCAL_CODEX_MODEL=
LOCAL_CLAUDE_MODEL=
# Optional executable overrides. macOS defaults to the Codex app binary if present.
# LOCAL_CODEX_BIN=/Applications/Codex.app/Contents/Resources/codex
# LOCAL_CLAUDE_BIN=/Users/your-name/.local/bin/claude
