# Backend origin for hosted builds. Leave unset in dev — the Vite proxy
# forwards /api to localhost:8000. On Vercel, set this to the Railway URL
# (e.g. https://calibration-arena-production.up.railway.app) or, once the
# domain is attached, https://api.calibrationarena.ai
VITE_API_URL=
# Clerk publishable key. The name must start with VITE_; Clerk's dashboard shows
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, which Vite ignores. It must come from the same
# Clerk instance as the backend's CLERK_SECRET_KEY.
VITE_CLERK_PUBLISHABLE_KEY=
# PostHog public project token and ingestion host. Both must be VITE_-prefixed
# so the browser client can read them.
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com
