# Backend origin for hosted builds. Leave unset in dev — the Vite proxy
# forwards /api to localhost:8000. On Vercel, set this to the Railway URL
# (e.g. https://calibration-arena-production.up.railway.app) or, once the
# domain is attached, https://api.calibrationarena.ai
VITE_API_URL=
VITE_CLERK_PUBLISHABLE_KEY=
