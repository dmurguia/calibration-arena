# Design Arena (recreation) — environment template.
# Copy to .env (or export) and swap PLACEHOLDER values for real credentials.

# --- Core ---
# Session-token signing secret. REQUIRED in production.
ARENA_SECRET_KEY=PLACEHOLDER_GENERATE_A_LONG_RANDOM_SECRET

# SQLite (default, zero-config) or Postgres:
# ARENA_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/designarena

# --- Generation ---
# sample (default): offline persona-based designs, no keys needed.
# live: route each model to its vendor API — requires the keys below.
ARENA_GENERATION_MODE=sample

# Live-mode provider keys (only needed when ARENA_GENERATION_MODE=live)
ANTHROPIC_API_KEY=PLACEHOLDER_ANTHROPIC_API_KEY
OPENAI_API_KEY=PLACEHOLDER_OPENAI_API_KEY
GOOGLE_API_KEY=PLACEHOLDER_GOOGLE_API_KEY
# Catch-all for GLM / DeepSeek / Qwen / Grok / Llama / Kimi / Mistral / MiniMax
OPENROUTER_API_KEY=PLACEHOLDER_OPENROUTER_API_KEY

# --- Auth email delivery ---
# Login codes are emailed in production (Resend/SendGrid/etc). Until a key is
# wired, dev mode returns the code in the API response.
EMAIL_PROVIDER_API_KEY=PLACEHOLDER_RESEND_OR_SENDGRID_KEY
# Set to 0 once real email delivery works:
ARENA_DEV_LOGIN_CODE=1

# --- Pipeline tuning ---
# Bootstrap resamples for leaderboard confidence intervals.
ARENA_CI_ROUNDS=40

# --- Accountant pilot ---
PILOT_ADMIN_TOKEN=PLACEHOLDER_LONG_RANDOM_FOUNDER_TOKEN
PILOT_SESSION_DAYS=30
PILOT_TOKEN_BUDGET=200000
PILOT_GUEST_TOKEN_BUDGET=30000
PILOT_GLOBAL_DAILY_TOKENS=3000000
PILOT_PUBLIC_LEADERBOARD=0
# Pool mode requires at least two unique provider:model entries and each
# provider's corresponding API key.
# ARENA_INFERENCE_BACKEND=pool
# PILOT_MODELS=anthropic:claude-opus-4-1,openai:gpt-5,openrouter:google/gemini-2.5-pro
# ARENA_TRUST_PROXY=0
# ARENA_PROXY_HOPS=1
